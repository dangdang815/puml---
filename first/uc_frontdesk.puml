@startuml uc_frontdesk
skinparam dpi 150
skinparam defaultFontName "Microsoft YaHei"
skinparam usecaseFontSize 13
left to right direction

actor 前台接待员
actor 财务人员

package "前台接待子系统" {
  usecase "办理入住登记" as UC04
  usecase "办理退房结算" as UC05
  usecase "换房" as UC06
  usecase "续住" as UC07
  usecase "查询房态与房价" as UC01
}

前台接待员 --> UC04
前台接待员 --> UC05
前台接待员 --> UC06
前台接待员 --> UC07
财务人员 --> UC05

UC04 ..> UC01 : <<include>>
UC06 ..> UC04 : <<extend>>
UC07 ..> UC04 : <<extend>>
@enduml
