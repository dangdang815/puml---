@startuml uc_overall
skinparam dpi 150
skinparam defaultFontName "Microsoft YaHei"
skinparam usecaseFontSize 13
left to right direction

actor 顾客
actor 前台接待员
actor 客房服务员
actor 客房部主管
actor 财务人员
actor 系统管理员

rectangle "酒店管理系统" {
  package "客房预订子系统" {
    usecase "查询房态与房价" as UC01
    usecase "预订客房" as UC02
    usecase "取消预订" as UC03
  }
  package "前台接待子系统" {
    usecase "办理入住登记" as UC04
    usecase "办理退房结算" as UC05
    usecase "换房" as UC06
    usecase "续住" as UC07
  }
  package "客房管理子系统" {
    usecase "房态查询与维护" as UC08
    usecase "清洁登记" as UC09
    usecase "维修报障与恢复" as UC10
  }
  package "会员管理子系统" {
    usecase "会员注册" as UC11
    usecase "会员信息维护" as UC12
  }
  package "系统管理子系统" {
    usecase "用户登录与登出" as UC13
    usecase "用户与权限管理" as UC14
    usecase "房型与房价维护" as UC15
    usecase "经营报表统计" as UC16
  }
}

顾客 --> UC01
顾客 --> UC02
顾客 --> UC03
顾客 --> UC11
顾客 --> UC13
前台接待员 --> UC04
前台接待员 --> UC05
前台接待员 --> UC06
前台接待员 --> UC07
前台接待员 --> UC13
客房服务员 --> UC08
客房服务员 --> UC09
客房部主管 --> UC08
客房部主管 --> UC10
客房部主管 --> UC13
财务人员 --> UC13
财务人员 --> UC16
系统管理员 --> UC13
系统管理员 --> UC14
系统管理员 --> UC15
系统管理员 --> UC16

UC02 ..> UC01 : <<include>>
UC04 ..> UC01 : <<include>>
UC08 ..> UC01 : <<include>>
@enduml
